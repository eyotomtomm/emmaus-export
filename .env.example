# Copy to .env on the server (cPanel: File Manager, app root) and fill in.
# .env is gitignored - never commit the real one.
#
# Generate the secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SETTINGS_MODULE=config.settings.cpanel
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=emmausimportexport.com,www.emmausimportexport.com

# The domain's certificate is active, so HTTPS is enforced. Start HSTS small
# and raise it to 518400 after a day of confirming nothing broke.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=60

# cPanel mailbox (Email Accounts -> Connect Devices for the exact host)
DJANGO_EMAIL_HOST=mail.emmausimportexport.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=info@emmausimportexport.com
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=info@emmausimportexport.com
